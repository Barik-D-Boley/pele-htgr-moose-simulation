# ==============================================================================
# Coreform Cubit Journal File: HTGR RVE (quarter cell)
#
# Produces htgr_rve_mesh.e with TWO blocks:
#   block 1 "matrix_graphite"  -- the graphite with the two quarter holes
#   block 2 "fuel_compact"     -- the quarter fuel compact that fills the fuel hole
# The coolant hole stays empty (it is handled by a convection BC in MOOSE).
#
# Layout (mm): box 18.80 x 9.40, FULL fuel-column height 800 mm
#   coolant hole r = 7.94 at corner (0, 0)
#   fuel hole    r = 6.35 at corner (18.80, 9.40)
# The STEP file is only 20 mm tall, so it is stretched 40x in z below.
# Height must match HEIGHT in neutronics/openmc_rve_model.py (80 cm).
# ==============================================================================
reset

# 1. Import the graphite matrix (becomes volume 1) and convert mm -> m.
#    x, y: mm -> m (x 0.001).  z: 20 mm -> 0.8 m (x 0.04).
#    If Cubit rejects non-uniform scaling, instead change the SolidWorks
#    extrusion to 800 mm, re-export the STEP, and use "volume all scale 0.001".
import step "../cad/htgr_rve_matrix.STEP" heal
volume all scale x 0.001 y 0.001 z 0.04

# 2. Build the quarter fuel compact (new volume):
#    a brick the size of the whole cell, cut by a cylinder on the fuel axis,
#    then throw away everything except the quarter-cylinder piece.
brick x 0.0188 y 0.0094 z 0.8
move volume 2 location 0.0094 0.0047 0.4
webcut volume 2 with cylinder radius 0.00635 axis z center 0.0188 0.0094 0.4
# The fuel piece's centroid is at x ~ 0.0161 m; the leftover piece's is at x ~ 0.0079 m.
delete volume all except 1 with x_coord < 0.012

# 3. Make the fuel and graphite share nodes on their common wall
imprint volume all
merge volume all

# 4. Mesh (sweep along z)
#    In-plane element size 0.55 mm (same as before). Along z the power and
#    temperature change slowly, so use longer elements: 200 layers = 4 mm.
#    (Aspect ratio ~7 along z is fine for this smooth axial variation.)
#    Roughly 70-80k elements total. Reduce "interval 200" if it is too slow.
volume all scheme sweep
volume all size 0.00055
curve with length > 0.5 interval 200
mesh volume all

# 5. Sidesets (picked by position so they include faces of BOTH volumes)
#    x_coord / y_coord / z_coord refer to the center of each surface.
sideset 1 add surface with z_coord > 0.799
sideset 1 name "top_face"

sideset 2 add surface with z_coord < 0.0001
sideset 2 name "bottom_face"

sideset 3 add surface with x_coord < 0.0001
sideset 3 name "symm_x_min"

sideset 4 add surface with x_coord > 0.0187
sideset 4 name "symm_x_max"

sideset 5 add surface with y_coord < 0.0001
sideset 5 name "symm_y_min"

sideset 6 add surface with y_coord > 0.0093
sideset 6 name "symm_y_max"

# Curved walls (same surface numbers as the original matrix import).
# CHECK in the GUI that these are still the right surfaces after the merge.
sideset 7 add surface 6
sideset 7 name "fuel_wall"

sideset 8 add surface 3
sideset 8 name "coolant_wall"

# 6. Blocks
block 1 add volume 1
block 1 name "matrix_graphite"

block 2 add volume all except 1
block 2 name "fuel_compact"

# 7. Quality check -- look at the minimum scaled Jacobian in the output
quality volume all scaled jacobian global

# 8. Export
export mesh "htgr_rve_mesh.e" overwrite
system "del step_import.log"

# System & Editor Files
.DS_Store
Thumbs.db
.vscode/

# SolidWorks / Office temporary lock files
~$*

# Python & Environment Cache
__pycache__/
*.py[cod]
.venv/
*.env

# STEP to Cubit log file
*.log

# OpenMC Nuclear Data Downloads & Extracts
*.xz
*-hdf5/
endfb-viii.0-hdf5/
nndc_hdf5/

# OpenMC Run Outputs & Generated Files
statepoint.*.h5
summary.h5
tallies.out
neutronics/*.xml

# Exodus, Nemesis, and CSV output files
*_out.e
*.e.*-*
*.n
*.nem
*.csv

# Generated OpenMC -> MOOSE power grid
moose/openmc_power.txt

# MOOSE checkpoint and recovery directories
*_cp/
*_csv/

# MOOSE Compiled Executables
*-opt
*-dbg
# MOOSE JIT cache (ParsedMaterial)
.jitcache/

# Coolant sweep run files (regenerated by post-processing/coolant_sweep.py setup)
moose/sweep/

# OpenMC run at operating temperatures (openmc_rve_model.py --operating-temps)
neutronics/hot/

# MOOSE run with the operating-temperature OpenMC power
moose/hot/

# Mesh convergence run (Mesh/uniform_refine=1)
moose/refine/
